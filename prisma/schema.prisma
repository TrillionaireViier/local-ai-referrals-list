generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ReferralSnapshot {
  id        String   @id @default(uuid())
  username  String
  handle    String
  referrals Int
  createdAt DateTime @default(now())

  @@index([username])
  @@index([createdAt])
}
